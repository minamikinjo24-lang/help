<%- include('partials/header', { title: '問い合わせ一覧' }) %>

<h1>問い合わせ一覧</h1>
<p><a href="/tickets/new">新規作成</a></p>

<% if (tickets.length === 0) { %>
  <p>問い合わせはまだありません。</p>
<% } else { %>
  <table border="1" cellpadding="4">
    <thead>
      <tr>
        <th>ID</th><th>タイトル</th><th>ステータス</th><th>優先度</th><th>更新日時</th>
      </tr>
    </thead>
    <tbody>
      <% tickets.forEach(function (t) { %>
        <tr>
          <td><%= t.id %></td>
          <td><%= t.title %></td>
          <td><%= t.status %></td>
          <td><%= t.priority %></td>
          <td><%= t.updated_at %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer') %>
