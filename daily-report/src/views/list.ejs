<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>過去の日報</title>
</head>
<body>

<h1>過去の日報</h1>
<p><a href="/">日報を作成する</a></p>

<% if (reports.length === 0) { %>
  <p>まだありません。</p>
<% } else { %>
  <% reports.forEach(function (r) { %>
    <div style="border:1px solid #ccc; padding:8px; margin:8px 0; max-width:36em">
      <strong><%= r.report_date %></strong>
      <p style="white-space:pre-wrap; margin:6px 0"><%= r.items %></p>
    </div>
  <% }); %>
<% } %>

</body>
</html>
