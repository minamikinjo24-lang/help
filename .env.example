# 値はこのファイルに書かない。.env にコピーして各自が設定する。
# .env は .gitignore 済み。本番の値はデプロイ先の環境変数機能で渡すこと。

# --- 必須（未設定なら起動時に停止する）-----------------------------------
# Google Workspace / Google アカウントを使う場合: https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 公開URL。コールバックURLの組み立てに使う。例: https://helpdesk.example.com
BASE_URL=
# セッションCookieの署名鍵。次で生成できる:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- 任意 -----------------------------------------------------------------
# ログインを許可する社内ドメイン（Google の hd クレーム）。未設定なら制限しない。
# 個人の @gmail.com には hd が無いため、その場合は空にする。
OIDC_ALLOWED_HD=

# 問い合わせ作成時に {"id":..,"title":".."} を POST する先。未設定なら通知しない
# （通知しなくても作成は成功する）。
NOTIFICATION_WEBHOOK_URL=

# 待ち受けポート。未設定なら 3000。多くのPaaSは自動で設定する。
PORT=

# SQLite ファイルの置き場。未設定なら ./data/help.db。
# 本番では永続ボリューム上のパスを指定すること。例: /data/help.db
DB_PATH=

# 信頼するプロキシのホップ数。未設定なら 1。
# BASE_URL が https のときだけ有効。多段プロキシの場合のみ変更する。
TRUST_PROXY_HOPS=

# --- 検証用 ---------------------------------------------------------------
# http のモックIdPを使うときだけ 1。本番では絶対に設定しないこと。
OIDC_ALLOW_INSECURE=
