# 値はこのファイルに書かない。.env にコピーして各自が設定する。
# .env は .gitignore 済み。

# --- OAuth / OIDC ---------------------------------------------------------
# Google Workspace を使う場合の例: https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# ログインを許可する社内ドメイン（Google の hd クレーム）。未設定なら制限しない。
OIDC_ALLOWED_HD=

# --- アプリ ---------------------------------------------------------------
# コールバックURLの組み立てに使う。例: http://localhost:3000
BASE_URL=
# セッションCookieの署名鍵
SESSION_SECRET=

# --- 通知 -----------------------------------------------------------------
# 問い合わせ作成時に {"id":..,"title":".."} を POST する先。未設定なら通知しない。
NOTIFICATION_WEBHOOK_URL=

# --- 検証用 ---------------------------------------------------------------
# http のモックIdPを使うときだけ 1。本番では設定しないこと。
OIDC_ALLOW_INSECURE=
